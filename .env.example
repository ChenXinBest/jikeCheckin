# 极客云账号配置（必填）
JIKE_EMAIL=your_email@example.com
JIKE_PASSWORD=your_password

# 代理配置（可选，如直连失败时使用）
# JIKE_PROXY=http://127.0.0.1:7890

# Gotify 通知配置（可选）
GOTIFY_HOST=https://gotify.example.com
GOTIFY_TOKEN=your_app_token

# WXPUSH 通知配置（可选，三项都填写才会推送）
# WXPUSH_BASE_URL=https://your-wxpush-host.example.com/wxsend
# WXPUSH_USERID=your_wxpush_userid
# WXPUSH_TEMPLATE_ID=your_wxpush_template_id

# 日志级别（可选，默认 INFO）
# 可选值：DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
